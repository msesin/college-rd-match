# Secrets and private data: never commit
.env
data/
*.sqlite3
*.sqlite3.gz
*.sqlite3-*

# Python / tooling
.venv/
__pycache__/
*.pyc
.DS_Store
staticfiles/

# Keys, logs and documents (transcripts, CDS files) belong in data/ or nowhere
*.pem
*.key
*.log
*.pdf
*.heic

# Spreadsheets can hold student names: never commit them
*.csv
*.xlsx
*.xls
!sources/*.csv
