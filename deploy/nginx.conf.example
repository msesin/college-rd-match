# Use this instead of the Caddyfile if the server already runs nginx for your other project.
# /etc/nginx/sites-available/ugs  (then: ln -s into sites-enabled, nginx -t, systemctl reload nginx,
# and run: sudo certbot --nginx -d dashboard.example.com  to get the HTTPS certificate)
server {
    listen 80;
    server_name dashboard.example.com;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
