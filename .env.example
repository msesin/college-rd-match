# Copy this file to .env and fill in the values. .env is git-ignored; this file is not.
# Never put real secrets in this file.

# Django secret key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 for local development, 0 on a server
DJANGO_DEBUG=1


# LLM for generate_college_answers (vibe, AP/IB and olympiad columns).
# Gemini is used when GEMINI_API_KEY is set; otherwise ANTHROPIC_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini for OCR
GEMINI_API_KEY_OCR=
GEMINI_MODEL_OCR=gemini-3.5-flash-lite

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Maximum LLM requests per minute (match your plan's limit)
LLM_RPM=15

# Matching engine: Gemini rates students' own texts (school name, awards, activities, work experience,
# self-summary; de-identified: no names or emails). By default only the fictional "sample" students are sent.
# Set to 1 only with a paid Gemini plan whose terms do not use inputs for training.
ALLOW_STUDENT_DATA_TO_GEMINI=0

# --- Server only (leave unset on your laptop) ---
# Addresses the dashboard is served on, and their https:// origins
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Turn on once HTTPS works: 3600 first, later 31536000
DJANGO_HSTS_SECONDS=0

# Key that encrypts student names and emails (needed on your laptop too, e.g. for create_sample_students).
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy in a password manager: if it is lost, stored names cannot be recovered.
STUDENT_DATA_KEY=

# --- Email (sign-up links for students) ---
# Leave EMAIL_HOST empty on your laptop: emails are then printed in the terminal instead of sent.
# On the server, use an SMTP service (e.g. Google Workspace with an app password, Brevo, Mailjet,
# or Oracle Cloud Email Delivery).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=UGS College Counseling <counseling@your-domain.org>

# Who can sign up. Set to your organisation's email domain(s), comma-separated (e.g. ugs.foundation): anyone with
# an address there can create an account, and only they can (exact domain; loaded students outside it cannot).
# Leave empty to allow only students whose email was loaded by staff.
STUDENT_EMAIL_DOMAINS=
